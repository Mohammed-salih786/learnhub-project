# Flask backend
FLASK_API_URL=http://127.0.0.1:5000
PORT=5000
FLASK_DEBUG=false
CORS_ORIGINS=http://localhost:3000
WEB_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB Atlas (create a database user and allow your development/deployment IP)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.v3mhurl.mongodb.net/learnhub_platform?retryWrites=true&w=majority
MONGODB_DATABASE=learnhub_platform

# Use a unique random value of at least 32 characters
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@learnhub.in
ADMIN_REGISTRATION_KEY=choose-a-private-random-key-of-at-least-32-characters

# Optional integrations
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MONTHLY_PLAN_ID=
RAZORPAY_YEARLY_PLAN_ID=
BUNNY_API_KEY=
BUNNY_LIBRARY_ID=
BUNNY_STORAGE_ZONE=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Upload storage: use local only for development; use S3-compatible storage on Vercel
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
