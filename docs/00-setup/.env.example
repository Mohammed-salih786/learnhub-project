# LearnHub environment template
# Copy this file to .env.local for local development and to the platform secrets manager for staging/production.
# Keep staging and production secrets separate. Never commit real secrets.

# =========================
# APP CORE
# =========================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=LearnHub
NEXT_PUBLIC_COUNTRY=IN
NEXT_PUBLIC_DEFAULT_CURRENCY=INR

# =========================
# SUPABASE
# =========================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres
SUPABASE_JWT_SECRET=your-jwt-secret

# =========================
# RAZORPAY
# =========================
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
RAZORPAY_BASE_URL=https://api.razorpay.com
RAZORPAY_TEST_MODE=true

# Optional: plan or product references if created by the platform
RAZORPAY_MONTHLY_PLAN_ID=
RAZORPAY_YEARLY_PLAN_ID=

# =========================
# OTP / AUTH
# =========================
OTP_PROVIDER=msg91
MSG91_API_KEY=your-msg91-key
MSG91_SENDER_ID=LEARNHUB
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# =========================
# EMAIL
# =========================
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=hello@learnhub.in

# =========================
# VIDEO / BUNNY STREAM
# =========================
BUNNY_API_KEY=your-bunny-api-key
BUNNY_LIBRARY_ID=your-library-id
BUNNY_STORAGE_ZONE=your-storage-zone
BUNNY_VIDEO_API_HOST=video.bunnycdn.com
BUNNY_STREAM_REGION=ap-south-1

# =========================
# OBSERVABILITY
# =========================
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=development

# =========================
# STORAGE / FILES
# =========================
NEXT_PUBLIC_BUCKET_COURSES=course-assets
NEXT_PUBLIC_BUCKET_CERTIFICATES=certificates
NEXT_PUBLIC_BUCKET_NOTES=notes

# =========================
# SECURITY / DOMAIN
# =========================
APP_DOMAIN=localhost:3000
APP_PROTOCOL=http
ALLOWED_ORIGINS=http://localhost:3000,https://learnhub.in

# =========================
# ADMIN / OPS
# =========================
ADMIN_EMAIL=admin@learnhub.in
SUPPORT_EMAIL=support@learnhub.in

# =========================
# FEATURE FLAGS
# =========================
ENABLE_TRIAL=true
TRIAL_DAYS=7
TRIAL_FREE_COURSE_LIMIT=2
ENABLE_CERTIFICATES=true
